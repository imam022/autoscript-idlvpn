#!/bin/bash
CONF="/etc/idlvpn/agent.conf"
SERVICE="idlvpn-agent"
PORT="8448"

mkdir -p /etc/idlvpn

get_host() {
    for p in /etc/xray/domain /etc/v2ray/domain /root/domain; do
        if [[ -s "$p" ]]; then
            cat "$p" | tr -d ' \n\r'
            return
        fi
    done
    curl -s ifconfig.me
}

gen_token() {
    echo "IDL-$(openssl rand -hex 6 | tr 'a-z' 'A-Z')"
}

activate_agent() {
    if [[ ! -s "$CONF" ]] || ! grep -q "^TOKEN=" "$CONF"; then
        NEW_TOK=$(gen_token)
        echo "TOKEN=${NEW_TOK}" > "$CONF"
    fi
    if command -v ufw >/dev/null 2>&1; then
        ufw allow ${PORT}/tcp >/dev/null 2>&1
    fi
    iptables -I INPUT -p tcp --dport ${PORT} -j ACCEPT >/dev/null 2>&1
    systemctl daemon-reload
    systemctl enable ${SERVICE} >/dev/null 2>&1
    systemctl restart ${SERVICE}
}

if ! systemctl is-active --quiet ${SERVICE}; then
    activate_agent
fi

while true; do
    clear
    HOST=$(get_host)
    TOKEN=$(grep "^TOKEN=" "$CONF" 2>/dev/null | cut -d'=' -f2)
    if systemctl is-active --quiet ${SERVICE}; then
        STATUS="\033[1;32mAKTIF (ONLINE)\033[0m"
    else
        STATUS="\033[1;31mNONAKTIF (OFFLINE)\033[0m"
    fi

    echo -e "\033[1;36m━━━ IDLVPN ANDROID PANEL AGENT ━━━\033[0m"
    echo -e ""
    echo -e "\033[1;37mStatus Agent :\033[0m ${STATUS}"
    echo -e "\033[1;37mHost / Domain:\033[0m \033[1;36m${HOST}\033[0m"
    echo -e "\033[1;37mPort Agent   :\033[0m \033[1;33m${PORT}\033[0m"
    echo -e "\033[1;37mToken VPS    :\033[0m \033[1;32m${TOKEN}\033[0m"
    echo -e ""
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e " \033[1;33m[1]\033[0m Aktifkan / Refresh Agent"
    echo -e " \033[1;33m[2]\033[0m Generate Token Baru (Acak Ulang)"
    echo -e " \033[1;33m[3]\033[0m Nonaktifkan Agent"
    echo -e " \033[1;33m[0]\033[0m Kembali ke Menu Utama"
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    read -p "Pilih opsi [0-3]: " opt
    case "$opt" in
        1)
            activate_agent
            echo -e "\033[1;32mAgent berhasil diaktifkan!\033[0m"
            sleep 1
            ;;
        2)
            NEW_TOK=$(gen_token)
            echo "TOKEN=${NEW_TOK}" > "$CONF"
            systemctl restart ${SERVICE}
            echo -e "\033[1;33mToken baru berhasil dibuat: ${NEW_TOK}\033[0m"
            sleep 2
            ;;
        3)
            systemctl stop ${SERVICE}
            systemctl disable ${SERVICE} >/dev/null 2>&1
            echo -e "\033[1;31mAgent dinonaktifkan.\033[0m"
            sleep 1
            ;;
        0)
            menu
            exit 0
            ;;
    esac
done
