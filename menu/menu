#!/bin/bash
clear
GOLD='\033[1;33m'
LINE='\033[1;36m'
LABEL='\033[0;36m'
WHITE='\033[1;37m'
GREEN='\033[1;32m'
RED='\033[1;31m'
BADGE='\033[1;30;46m'
RESET='\033[0m'

IPVPS=$(curl -s ipv4.icanhazip.com)
domain=$(cat /etc/xray/domain 2>/dev/null)
LOADCPU=$(printf '%-0.00001s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
MODEL=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')
CORE=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
DATEVPS=$(date +'%d-%m-%Y')
TIMEZONE=$(printf '%(%H-%M-%S)T')
SERONLINE=$(uptime -p | cut -d " " -f 2-10000)
tram=$(free -m | awk 'NR==2 {print $2}')
uram=$(free -m | awk 'NR==2 {print $3}')

is_active() { systemctl is-active --quiet "$1" 2>/dev/null; }
status_on_error() { if is_active "$1"; then echo "${GREEN}ON${RESET}"; else echo "${RED}ERROR${RESET}"; fi; }
status_any_on_error() {
    for svc in "$@"; do
        if is_active "$svc"; then echo "${GREEN}ON${RESET}"; return; fi
    done
    echo "${RED}ERROR${RESET}"
}

status_ssh=$(status_any_on_error ssh sshd)
status_dropbear=$(status_on_error dropbear)
status_haproxy=$(status_on_error haproxy)
status_xray=$(status_on_error xray)
status_nginx=$(status_on_error nginx)
status_ws_epro=$(status_on_error ws)
status_udp=$(status_on_error udp-custom)
noobz=$(status_on_error noobzvpns)

vlx=$(grep -c -E "^#& " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vla=$vlx/2
vmc=$(grep -c -E "^### " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vma=$vmc/2
ssh1="$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)"
trx=$(grep -c -E "^#! " "/etc/xray/config.json" 2>/dev/null || echo 0)
let trb=$trx/2
ssx=$(grep -c -E "^#!# " "/etc/xray/config.json" 2>/dev/null || echo 0)
let ssa=$ssx/2

clear
echo -e ""
echo -e "  ${LINE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "    ${BADGE} IDLVPN ${RESET}  ${WHITE}TUNNELING INFRASTRUCTURE v2.0${RESET}"
echo -e "  ${LINE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  ${GOLD}>> SYSTEM & NETWORK${RESET}"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s${RESET}\n" "OS" "$MODEL"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s (%s)${RESET}\n" "Host / IP" "$domain" "$IPVPS"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Core (%s%%)${RESET}\n" "CPU Load" "$CORE" "$LOADCPU"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s / %s MB${RESET}\n" "RAM Usage" "$uram" "$tram"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s${RESET}\n" "Uptime" "$SERONLINE"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s • %s WIB${RESET}\n" "Time" "$DATEVPS" "$TIMEZONE"
echo -e "  ${LINE}────────────────────────────────────────────────────────${RESET}"
echo -e "  ${GOLD}>> ACTIVE ACCOUNTS${RESET}"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Akun${RESET}\n" "SSH / UDP" "$ssh1"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Akun${RESET}\n" "VMESS" "$vma"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Akun${RESET}\n" "VLESS" "$vla"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Akun${RESET}\n" "TROJAN" "$trb"
printf "    ${LABEL}%-10s${RESET} ${LINE}┃${RESET} ${WHITE}%s Akun${RESET}\n" "SHADOW" "$ssa"
echo -e "  ${LINE}────────────────────────────────────────────────────────${RESET}"
echo -e "  ${GOLD}>> SERVICE STATUS${RESET}"
echo -e "    ${LABEL}SSH:${RESET}$status_ssh ${LINE}┃${RESET} ${LABEL}XRAY:${RESET}$status_xray ${LINE}┃${RESET} ${LABEL}NGINX:${RESET}$status_nginx ${LINE}┃${RESET} ${LABEL}HAPROXY:${RESET}$status_haproxy"
echo -e "    ${LABEL}WS :${RESET}$status_ws_epro ${LINE}┃${RESET} ${LABEL}DROP:${RESET}$status_dropbear ${LINE}┃${RESET} ${LABEL}UDP  :${RESET}$status_udp ${LINE}┃${RESET} ${LABEL}NOOBZ  :${RESET}$noobz"
echo -e "  ${LINE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  ${GOLD}>> CONTROL PANEL${RESET}"
printf "    ${GOLD}[01]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[08]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[15]${RESET} ${WHITE}%-12s${RESET}\n" "SSH MENU" "BCKP/RSTR" "SLOWDNS"
printf "    ${GOLD}[02]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[09]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[16]${RESET} ${WHITE}%-12s${RESET}\n" "VMESS" "GOTOP RAM" "DOMAIN"
printf "    ${GOLD}[03]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[10]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[17]${RESET} ${WHITE}%-12s${RESET}\n" "VLESS" "RESTART" "FIX CERT"
printf "    ${GOLD}[04]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[11]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[18]${RESET} ${WHITE}%-12s${RESET}\n" "TROJAN" "COLOUR" "BANNER"
printf "    ${GOLD}[05]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[12]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[19]${RESET} ${WHITE}%-12s${RESET}\n" "NOOBZVPN" "UPDATE" "RST BANNER"
printf "    ${GOLD}[06]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[13]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[20]${RESET} ${WHITE}%-12s${RESET}\n" "SS-LIBEV" "RUNNING" "SPEEDTEST"
printf "    ${GOLD}[07]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[14]${RESET} ${WHITE}%-11s${RESET} ${LINE}┃${RESET} ${GOLD}[21]${RESET} ${WHITE}%-12s${RESET}\n" "UDP CUST" "INFO PORT" "EKSTRAK"
echo -e "  ${LINE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "    ${GOLD}IDLVPN PREMIUM INFRASTRUCTURE • LIFETIME EDITION${RESET}"
echo -e ""
printf "  ${GOLD}Options [ 1 - 21 ] ❱❱❱ ${RESET}"
read opt
echo -e ""
case $opt in
1 | 01) clear; m-sshws ;;
2 | 02) clear; m-vmess ;;
3 | 03) clear; m-vless ;;
4 | 04) clear; m-trojan ;;
5 | 05) clear; m-noob ;;
6 | 06) clear; m-ssws ;;
7 | 07) clear; udepe ;;
8 | 08) clear; menu-backup ;;
9 | 09) clear; gotop ;;
10) clear; restart ;;
11) clear; change-color ;;
12) clear; update-menu ;;
13) clear; run ;;
14) clear; prot ;;
15) clear; m-slowdns ;;
16) clear; addhost ;;
17) clear; fixcert ;;
18) clear; nano /etc/issue.net ;;
19) clear; /etc/init.d/dropbear restart ;;
20) clear; speedtest ;;
21) clear; m-system ;;
0 | 00) exit ;;
x) menu ;;
*) clear; menu ;;
esac
