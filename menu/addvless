},{"id": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
sed -i '/#vlessgrpc$/a\#& '"$user $exp"'\
},{"id": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json

vlesslink1="vless://${uuid}@${domain}:443?encryption=none&security=tls&sni=${domain}&type=ws&host=${domain}&path=%2Fvless#${user}-WS-TLS"
vlesslink2="vless://${uuid}@${domain}:80?encryption=none&security=none&type=ws&host=${domain}&path=%2Fvless#${user}-WS-NTLS"
vlesslink3="vless://${uuid}@${domain}:443?encryption=none&security=tls&sni=${domain}&type=grpc&serviceName=vless-grpc&mode=gun#${user}-gRPC"
