#!/bin/bash
clear
IP=$(curl -sS ipv4.icanhazip.com)
date=$(date +"%Y-%m-%d")

cek=$(grep -c -E "^# BEGIN_Backup" /etc/crontab 2>/dev/null)
if [[ "$cek" -ge 1 ]]; then
    sts="[32m[ON][0m"
else
    sts="[31m[OFF][0m"
fi

EMAIL_NOW=$(cat /root/email 2>/dev/null)
[[ -z "$EMAIL_NOW" ]] && EMAIL_NOW="(Belum diatur)"

function start() {
    email=$(cat /root/email 2>/dev/null)
    if [[ -z "$email" ]]; then
        echo -e ""
        read -rp "Masukkan Email Penerima Backup : " -e email
        echo "$email" > /root/email
        cp -f /root/email /home/email 2>/dev/null
    fi
    sed -i "/^# BEGIN_Backup/,/^# END_Backup/d" /etc/crontab
    cat << EOF >> /etc/crontab
# BEGIN_Backup
5 0 * * * root /usr/local/sbin/backup auto
# END_Backup
EOF
    systemctl restart cron 2>/dev/null || service cron restart 2>/dev/null
    clear
    echo -e "━━━ AUTOBACKUP AKTIF ━━━"
    echo -e "• Jadwal : Setiap hari pukul 00:05"
    echo -e "• Tujuan : $(cat /root/email)"
    echo -e ""
    read -n 1 -s -r -p "Press any key to back on menu"
    autobackup
}

function stop() {
    sed -i "/^# BEGIN_Backup/,/^# END_Backup/d" /etc/crontab
    systemctl restart cron 2>/dev/null || service cron restart 2>/dev/null
    clear
    echo -e "━━━ AUTOBACKUP DIMATIKAN ━━━"
    echo -e ""
    read -n 1 -s -r -p "Press any key to back on menu"
    autobackup
}

function gantipenerima() {
    echo -e ""
    read -rp "Masukkan Email Penerima Baru : " -e email
    if [[ -n "$email" ]]; then
        echo "$email" > /root/email
        cp -f /root/email /home/email 2>/dev/null
        echo -e "Email penerima berhasil diperbarui ke: $email"
    fi
    sleep 1
    autobackup
}

function gantipengirim() {
    echo -e ""
    echo -e "Masukkan Akun Gmail Pengirim & App Password (16 karakter):"
    read -rp "Email Pengirim (Gmail) : " -e email
    read -rp "App Password           : " -e pwdd
    cat > /etc/msmtprc <<EOF
defaults
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
account default
host smtp.gmail.com
port 587
auth on
user $email
from $email
password $pwdd
logfile ~/.msmtp.log
EOF
    chmod 600 /etc/msmtprc
    echo -e "Konfigurasi SMTP pengirim berhasil disimpan."
    sleep 1
    autobackup
}

function testemail() {
    email=$(cat /root/email 2>/dev/null)
    if [[ -z "$email" ]]; then
        echo -e "Email penerima belum diatur!"
        sleep 1
        autobackup
        return
    fi
    echo -e "Percobaan pengiriman email backup dari VPS IDLVPN
IP VPS  : $IP
Tanggal : $date" | mail -s "Test Email Backup IDLVPN" "$email"
    echo -e "Email percobaan telah dikirim ke $email. Cek kotak masuk / folder Spam."
    sleep 2
    autobackup
}

echo -e "━━━ IDLVPN AUTOBACKUP DATA ━━━"
echo -e "• Status : $sts"
echo -e "• Email Penerima : $EMAIL_NOW"
echo -e ""
echo -e "  [1] Aktifkan Autobackup (00:05 Harian)"
echo -e "  [2] Matikan Autobackup"
echo -e "  [3] Ganti Email Penerima"
echo -e "  [4] Atur Email Pengirim (SMTP Gmail)"
echo -e "  [5] Test Kirim Email"
echo -e "  [0] Kembali"
echo -e ""
read -rp "Pilih menu [1-5/0] : " num
case $num in
    1) start ;;
    2) stop ;;
    3) gantipenerima ;;
    4) gantipengirim ;;
    5) testemail ;;
    0) menu-backup ;;
    *) autobackup ;;
esac
